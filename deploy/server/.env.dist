# ~/services/portfolio/.env on the host.
# PORTFOLIO_IMAGE is rewritten by deploy.sh on every successful deploy; edit it
# by hand and `docker compose up -d` to roll back to an earlier sha tag.
PORTFOLIO_IMAGE=ghcr.io/<owner>/portfolio:latest

# The only repository this host will accept a deploy from. Moving the repo to a
# different owner or organisation means changing this one line.
ALLOWED_IMAGE_REPO=ghcr.io/<owner>/portfolio

VITE_SITE_URL=https://eduindev.com
