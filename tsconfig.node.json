{
	"include": ["vite.config.ts", "react-router.config.ts", "vitest.config.ts"],
	"compilerOptions": {
		"lib": ["ES2022"],
		"target": "ES2022",
		"module": "Preserve",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["node"]
	}
}
